# Copy to .env and fill in real values (never commit .env files)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=projects
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
ENVIRONMENT=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Frontend: copy frontend/.env.example to frontend/.env.local
